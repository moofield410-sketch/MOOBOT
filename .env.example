# Moofield environment variables: names only, no values.
#
# Local development: copy this file to .env.local and fill it in. Never commit .env.local.
# Netlify: add each one under Site configuration > Environment variables, then redeploy
# (Deploys > Trigger deploy > Deploy site). Netlify only applies env var changes on a new deploy.
# Never paste real keys into chat.
#
# Labels:
#   [SECRET, server-only]  Never sent to the browser. Keep it private.
#   [server-only]          Never sent to the browser, but not a secret.
#   [PUBLIC]               Has the NEXT_PUBLIC_ prefix, so Next.js builds it into the browser
#                          JavaScript. Anyone can read it. Changing it needs a rebuild.

# --- Required in production ---------------------------------------------------------------

# [SECRET, server-only] Signs the sign-in session cookie. At least 32 random characters.
# Without it in production, wallet sign-in is turned off.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# [SECRET, server-only] Protects /api/cron/scan in production. The Netlify scheduled function
# (netlify/functions/refresh-orbio.mjs) sends it as: Authorization: Bearer <CRON_SECRET>.
# Without it the route refuses every call and the scheduled refresh is skipped.
# Generate one the same way as SESSION_SECRET.
CRON_SECRET=

# --- Recommended --------------------------------------------------------------------------

# [SECRET, server-only] RPC endpoint for Robinhood Chain (chain ID 4663). Used to read $ORBIO
# balances on My Wallet and to verify smart-wallet signatures. Read-only use. Treat it as a
# secret: a provider URL usually contains your API key.
RPC_URL=

# [PUBLIC] WalletConnect (Reown) project ID, from https://dashboard.reown.com. Public by design.
# Leave empty to offer browser wallets only (/status then shows "WalletConnect: not configured").
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Launch day ---------------------------------------------------------------------------

# [server-only] The $MOOBOT launch switch. Leave EMPTY until $MOOBOT exists on Orbio: every $MOOBOT item
# then shows "Not launched yet". On launch day set it to the $MOOBOT token contract address
# (0x… 40 hex characters). The site checks the format and checksum, then confirms the token exists
# on the Orbio API before turning on any $MOOBOT feature. If Orbio doesn't know it, $MOOBOT stays off
# and /status shows a warning.
MOOBOT_TOKEN_ADDRESS=

# --- Optional: live X posts on the home page ---------------------------------------------

# [SECRET, server-only] X API bearer token (developer.x.com > your app > Keys and tokens).
# Set it and the "From X" section shows the latest posts of the account in SOCIAL.x (config.ts),
# in the site's own style. X bills per post read (pay-per-use); posts are cached for 15 minutes,
# so this costs well under $1 a month. Leave empty to show featured posts or a follow card instead.
X_BEARER_TOKEN=

# --- Testing only (do NOT set on Netlify) -------------------------------------------------

# [server-only] Points the Orbio API at a recorded stub. Used by scripts/smoke-routes.mjs.
# ORBIO_API_BASE_URL=
# [server-only] Same for the X API (local previews of the From X section).
# X_API_BASE_URL=

# --- Development only (ignored when NODE_ENV=production) ----------------------------------

# [server-only] Dry-run the schedule on a short clock.
# DEV_AGENT_LIVE_AT accepts an ISO timestamp or "now" (the moment the server started).
# DEV_HOUR_MS sets how long one "hour" lasts. 60000 = 1 minute, so the full unlock arrives after 24 minutes.
# DEV_AGENT_LIVE_AT=
# DEV_HOUR_MS=

# --- Set by Netlify or netlify.toml (don't add these yourself) -----------------------------
# URL           The site's main address. Netlify sets it; used for page metadata and by the
#               scheduled function.
# NODE_VERSION  Set in netlify.toml.
# NODE_ENV      Leave unset on Netlify: "production" would skip devDependencies the build needs.
