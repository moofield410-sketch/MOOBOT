# Moofield environment variables: names only, no values.
#
# Local development: copy this file to .env.local and fill it in. Never commit .env.local.
# Netlify: add each one under Site configuration > Environment variables, then redeploy
# (Deploys > Trigger deploy > Deploy site). Netlify only applies env var changes on a new deploy.
# Never paste real keys into chat.
#
# Labels:
#   [SECRET, server-only]  Never sent to the browser. Keep it private.
#   [server-only]          Never sent to the browser, but not a secret.
#   [PUBLIC]               Has the NEXT_PUBLIC_ prefix, so Next.js builds it into the browser
#                          JavaScript. Anyone can read it. Changing it needs a rebuild.

# --- Required in production ---------------------------------------------------------------

# [SECRET, server-only] Signs the sign-in session cookie. At least 32 random characters.
# Without it in production, wallet sign-in is turned off.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# [SECRET, server-only] Protects /api/cron/scan in production. The Netlify scheduled function
# (netlify/functions/refresh-orbio.mjs) sends it as: Authorization: Bearer <CRON_SECRET>.
# Without it the route refuses every call and the scheduled refresh is skipped.
# Generate one the same way as SESSION_SECRET.
CRON_SECRET=

# --- Recommended --------------------------------------------------------------------------

# [SECRET, server-only] RPC endpoint for Robinhood Chain (chain ID 4663). Used to read $ORBIO
# balances on My Wallet and to verify smart-wallet signatures. Read-only use. Treat it as a
# secret: a provider URL usually contains your API key.
RPC_URL=

# [PUBLIC] WalletConnect (Reown) project ID, from https://dashboard.reown.com. Public by design.
# Leave empty to offer browser wallets only (/status then shows "WalletConnect: not configured").
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Orbio gateway: MooBot chat and auto-posts (optional, they spend your Orbio balance) --------

# [SECRET, server-only] Your Orbio gateway key, from orbio.so/dashboard. Paste it only into Netlify,
# never into chat or code. Without it the chat stays off and nothing is posted.
ORBIO_API_KEY=

# [server-only] "on" shows "Ask MooBot a question" in the floating MooBot. Answers cost about
# $0.007 each. Limits in config.ts: GATEWAY.chat.dailyBudgetUsd (daily spending) and
# GATEWAY.chat.perVisitorPerDay (questions per visitor); null = no limit. Empty or anything else = off.
MOOBOT_CHAT=

# [server-only] Posts to @M00FIELD (connect the X account at orbio.so/dashboard#tools first).
#   preview (the default when empty): drafts only, shown on the Status page. Costs nothing.
#   on: really posts (about $0.015 each, at most GATEWAY.autopost.postsPerDay a day).
#   off: nothing.
AUTO_POST=

# [server-only] The MooBot Eco Bot: watches every agent on Orbio, researches (Orbio data, the
# token's own X posts, web search) and decides itself what to post. Posts are paced (at least
# ECOBOT.minGapMinutes apart in config.ts), with no daily limit beyond Orbio's own 50 a day.
#   off (the default when empty): nothing.
#   preview: decides and writes drafts for the Status page. Uses AI and research credits, posts nothing.
#   on: posts. Needs ORBIO_API_KEY, CRON_SECRET and the X account connected in Orbio.
# While it's preview or on, the fixed recap and graduation posts are left to it.
# It runs four jobs (lib/ecobot/jobs.ts): news (the signals above), mentions (answers posts that
# mention @M00FIELD), compose (its own explainers, builder logs, spotlights, Tournament calls,
# polls) and study (hourly research into its memory; no spending limit, spend is shown on Status).
# In preview, posts and replies are drafts; study still runs (and spends) so it learns.
ECO_BOT=

# [server-only] Optional. Which Eco Bot jobs run, comma-separated: news, mentions, compose, study.
# Empty = all four. Example: "news,study" to let it learn for a day before it talks.
ECO_BOT_JOBS=

# [server-only] Optional. Kinds of post never to send, comma-separated: launch, board, recap, graduation.
# Example: "launch" if you already posted the launch announcement yourself.
AUTO_POST_SKIP=

# --- Launch day ---------------------------------------------------------------------------

# [server-only] The $MOOBOT launch switch. Leave EMPTY until $MOOBOT exists on Orbio: every $MOOBOT item
# then shows "Not launched yet". On launch day set it to the $MOOBOT token contract address
# (0x… 40 hex characters). The site checks the format and checksum, then confirms the token exists
# on the Orbio API before turning on any $MOOBOT feature. If Orbio doesn't know it, $MOOBOT stays off
# and /status shows a warning.
MOOBOT_TOKEN_ADDRESS=

# --- Testing only (do NOT set on Netlify) -------------------------------------------------

# [server-only] Points the Orbio API at a recorded stub. Used by scripts/smoke-routes.mjs.
# ORBIO_API_BASE_URL=
# [server-only] Points the Orbio gateway (chat, posts) at a stub, for local checks.
# ORBIO_GATEWAY_BASE_URL=

# --- Development only (ignored when NODE_ENV=production) ----------------------------------

# [server-only] Dry-run the schedule on a short clock.
# DEV_AGENT_LIVE_AT accepts an ISO timestamp or "now" (the moment the server started).
# DEV_HOUR_MS sets how long one "hour" lasts. 60000 = 1 minute, so the full unlock arrives after 24 minutes.
# DEV_AGENT_LIVE_AT=
# DEV_HOUR_MS=

# --- Set by Netlify or netlify.toml (don't add these yourself) -----------------------------
# URL           The site's main address. Netlify sets it; used for page metadata and by the
#               scheduled function.
# NODE_VERSION  Set in netlify.toml.
# NODE_ENV      Leave unset on Netlify: "production" would skip devDependencies the build needs.

# The Tournament's moderators (server-only): comma-separated wallet addresses that may hide spam or
# scam pitches. They sign in on the site with that wallet; a "Moderator: hide" button then appears
# on each pitch. Every hide is listed with its reason in the round's audit log.
MODERATOR_WALLETS=

# Local end-to-end checks only (scripts/e2e-tournament.mjs): lets DEV_AGENT_LIVE_AT / DEV_HOUR_MS
# run on a built site. NEVER set this on Netlify: the Status page shows a warning if it is on.
# MOOFIELD_LOCAL_TEST=
